# Local Postgres credentials. The setup wizard creates pilot-runtime/.env;
# do not commit it or paste either value into chat.
PILOT_ADMIN_DB_PASSWORD=
PILOT_WEB_DB_PASSWORD=
PILOT_ADMIN_DATABASE_URL=
PILOT_DATABASE_URL=

# Auth0 browser-session configuration. The Client Secret and session Secret
# belong only in pilot-runtime/.env, never in source control or chat.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email
APP_BASE_URL=http://localhost:3001

# Auth0 access-token verification; required before Pilot deployment.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
